model = "opendesign/deepseek-v4.1-flash"
# magpie: Codex on magpie's local gateway; Disconnect in magpie or `magpie uninstall` undoes it, or delete this line and the model line
model_provider = "magpie"
# magpie: magpie's model list for Codex; Disconnect in magpie or `magpie uninstall` undoes it, or delete this line
model_catalog_json = "/home/user/.codex/magpie-models.json"
# magpie: points at magpie's local gateway; Disconnect in magpie or `magpie uninstall` undoes it, or delete this line
openai_base_url = "http://127.0.0.1:3425/backend-api/codex"
[projects."/etc/nixos"]
trust_level = "trusted"

[model_providers.magpie]
name = "magpie"
base_url = "http://127.0.0.1:3425/v1"
wire_api = "responses"
experimental_bearer_token = "magpie"
http_headers = { "x-openai-actor-authorization" = "magpie" }
capabilities = { "remote_compaction" = "v2" }

[desktop]
enabled-reasoning-efforts = ["low", "medium", "high", "xhigh", "ultra", "persistent", "none", "minimal", "max"]

[mcp_servers.magpie]
# magpie: points at magpie's local gateway; Disconnect in magpie or `magpie uninstall` undoes it, or remove this entry and pick another model
url = "http://127.0.0.1:3425/mcp/magpie/hub/codex"

[features.async_compaction]
enabled = true
