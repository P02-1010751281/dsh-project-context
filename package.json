{
  "name": "dsh-project-context",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugins porting the author's custom pi context extensions: project memory (MEMORY.md + learned skills) and session context (CONTEXT.md + session logs), with a shared autolearn pass writing into the project's .agents/ directory.",
  "type": "module",
  "main": "./lib/session-context.js",
  "types": "./lib/session-context.d.ts",
  "exports": {
    ".": {
      "types": "./lib/session-context.d.ts",
      "default": "./lib/session-context.js"
    },
    "./memory": {
      "types": "./lib/memory.d.ts",
      "default": "./lib/memory.js"
    },
    "./handoff": {
      "types": "./lib/handoff.d.ts",
      "default": "./lib/handoff.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "LICENSE",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "scripts": {
    "build": "tsc && node scripts/build-client.mjs",
    "build:client": "node scripts/build-client.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.client.json --noEmit"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "context",
    "memory",
    "autolearn"
  ],
  "license": "MIT",
  "author": "呼啸山庄 (P02-1010751281)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/P02-1010751281/dsh-project-context.git"
  },
  "homepage": "https://github.com/P02-1010751281/dsh-project-context#readme",
  "bugs": {
    "url": "https://github.com/P02-1010751281/dsh-project-context/issues"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-store": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.5-rc.2",
    "@deepseek-ai/dsh-commands": "0.1.5-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session": "0.1.5-rc.2",
    "@deepseek-ai/dsh-settings": "0.1.5-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.5-rc.2",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.31",
    "esbuild": "^0.28.2",
    "react": "^18.3.1",
    "typescript": "^5.9.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": ">=0.1.5-rc.2",
    "@deepseek-ai/dsh-commands": ">=0.1.5-rc.2",
    "@deepseek-ai/dsh-llm": ">=0.1.5-rc.2",
    "@deepseek-ai/dsh-session": ">=0.1.5-rc.2",
    "@deepseek-ai/dsh-settings": ">=0.1.5-rc.2",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.5-rc.2",
    "@deepseek-ai/schemastery": "^3.18.2"
  }
}
